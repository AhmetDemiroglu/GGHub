#!/bin/bash
# Git hook'larini kurar. Bir kez calistir; .git/hooks versiyonlanmadigi icin repoyu
# klonlayan herkesin kendi makinesinde tekrar calistirmasi gerekir.
#
#   scripts/install-hooks

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
HOOK="$REPO_ROOT/.git/hooks/pre-push"

[ -d "$REPO_ROOT/.git" ] || { echo "HATA: .git bulunamadi."; exit 1; }

cat > "$HOOK" <<'HOOK_EOF'
#!/bin/bash
# GGHub pre-push. scripts/install-hooks tarafindan olusturuldu.
#
# main'e push = Railway + Vercel deploy. Bu yuzden kontrol commit'te degil PUSH'ta:
# yerelde istedigin kadar ara commit atabilirsin, ama prod'a giden sey tutarli olsun.

REPO_ROOT="$(git rev-parse --show-toplevel)"
"$REPO_ROOT/scripts/check-migrations" || exit 1
HOOK_EOF

chmod +x "$HOOK"
chmod +x "$SCRIPT_DIR/check-migrations" 2>/dev/null || true

# Katalog botunun otomatik guncellemesi. origin/main bu makinede her degistiginde (push VEYA
# pull/fetch) bot arka planda origin/main'den yeniden derlenir. Ayrintilar: scripts/gghub-bot
# icindeki "Otomatik guncelleme" bolumu. Bot kurulu olmayan makinede hook hicbir sey yapmaz.
REF_HOOK="$REPO_ROOT/.git/hooks/reference-transaction"
cat > "$REF_HOOK" <<'HOOK_EOF'
#!/bin/bash
# GGHub reference-transaction. scripts/install-hooks tarafindan olusturuldu.
#
# DIKKAT: "prepared" asamasinda sifir disi cikis ref guncellemesini IPTAL eder. Bu hook bu
# yuzden her yolda 0 ile cikar ve yalnizca "committed" asamasinda is yapar.

[ "$1" = "committed" ] || exit 0

main_changed=0
while read -r _old _new ref; do
  [ "$ref" = "refs/remotes/origin/main" ] && main_changed=1
done
[ "$main_changed" -eq 1 ] || exit 0
[ -x "$HOME/.gghub-bot/app/GGHub.Worker" ] || exit 0

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

# Surec git'ten tamamen koparilir (setsid): push komutu bitince, onu calistiran terminal veya
# arac kapansa da derleme yarim kalmaz. launchd'ye DEVREDILMEZ: macOS arka plan servislerinin
# KIOXIA'ya erisimini engelliyor; buradan dogan surec push'u yapan uygulamanin disk iznini tasir.
# GIT_* degiskenleri temizlenir, yoksa icerideki git komutlari bu hook'un baglamini devralirdi.
env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX \
  /usr/bin/perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' -- \
  "$REPO_ROOT/scripts/gghub-bot" autoupdate --no-fetch </dev/null >/dev/null 2>&1 &

exit 0
HOOK_EOF
chmod +x "$REF_HOOK"

echo "Kuruldu: $HOOK"
echo "Kuruldu: $REF_HOOK"
echo
echo "Artik 'git push' oncesi entity/migration uyumu kontrol edilir."
echo "origin/main her degistiginde katalog botu kendini gunceller (log: ~/.gghub-bot/logs/autoupdate.log)."
echo "Simdi denemek icin: scripts/check-migrations"
