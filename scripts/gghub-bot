#!/bin/bash
# GGHub katalog botu kontrol arayuzu.
#
#   gghub-bot install   -> derle, ~/.gghub-bot'a kur, acilista otomatik baslat
#   gghub-bot start | stop | restart
#   gghub-bot status    -> calisiyor mu + bu ayki Gemini harcamasi + kalan kuyruk
#   gghub-bot logs      -> canli log
#   gghub-bot update    -> repodan yeniden derle + kur + yeniden baslat
#   gghub-bot autoupdate-install -> otomatik guncelleyiciyi kur (bir kez)
#   gghub-bot autoupdate -> origin/main'de backend degistiyse yeniden derle + kur (LaunchAgent cagirir)
#   gghub-bot uninstall -> TAMAMEN kaldir: durdur + acilista baslatmayi iptal + dosyalari sil
#
# Bot NEDEN burada calisiyor: Railway'de 7/24 donen bir crawler prod container'inda CPU yakiyor
# ve faturayi yukseltiyordu. Job'lar artik GGHub.Worker'da ve yalnizca bu makinede calisiyor;
# Railway sadece Postgres yazmalarini goruyor (olculen maliyet: ayda birkac sent).

set -euo pipefail

BOT_HOME="${GGHUB_BOT_HOME:-$HOME/.gghub-bot}"
APP_DIR="$BOT_HOME/app"
LOG_DIR="$BOT_HOME/logs"
CONFIG="$BOT_HOME/appsettings.json"
LABEL="social.gghub.bot"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOTNET="$HOME/.dotnet/dotnet"

# Otomatik guncelleyici. Derleme alani KIOXIA'da (Mac diskine derleme ciktisi yazilmaz);
# disk takili degilse guncelleyici o turu sessizce atlar, bot eski surumle calismaya devam eder.
UPDATER_LABEL="social.gghub.bot-updater"
UPDATER_PLIST="$HOME/Library/LaunchAgents/$UPDATER_LABEL.plist"
UPDATER_SCRIPT="$BOT_HOME/gghub-bot"
UPDATE_STAMP="$BOT_HOME/built-backend-tree"
UPDATE_LOG="$LOG_DIR/autoupdate.log"
BUILD_ROOT="${GGHUB_BOT_BUILD_ROOT:-/Volumes/KIOXIA/_caches/gghub-bot-build}"

# Repo yolu: bu script repo icinde durdugu icin kendi konumundan turetiliyor. Otomatik
# guncelleyici scriptin ~/.gghub-bot'taki kopyasini calistirir; o zaman yol GGHUB_REPO'dan gelir.
SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${GGHUB_REPO:-$(cd "$SCRIPT_PATH/.." && pwd)}"
WORKER_PROJ="$REPO_ROOT/backend/GGHub.Worker/GGHub.Worker.csproj"

c_red()  { printf '\033[31m%s\033[0m\n' "$*"; }
c_grn()  { printf '\033[32m%s\033[0m\n' "$*"; }
c_ylw()  { printf '\033[33m%s\033[0m\n' "$*"; }
c_dim()  { printf '\033[2m%s\033[0m\n' "$*"; }

die() { c_red "HATA: $*"; exit 1; }

is_loaded() { launchctl list 2>/dev/null | grep -q "$LABEL"; }

require_dotnet() {
  [ -x "$DOTNET" ] || die "dotnet bulunamadi: $DOTNET"
}

build_and_publish() {
  require_dotnet
  [ -f "$WORKER_PROJ" ] || die "Worker projesi bulunamadi: $WORKER_PROJ (KIOXIA takili mi?)"

  c_dim "Derleniyor: $WORKER_PROJ"
  # Cikti KIOXIA'ya DEGIL ev dizinine gidiyor: proje dis diskte ve disk takili degilken
  # login olunursa LaunchAgent coker. Boylece bot disk olmadan da calisir; disk yalnizca
  # yeniden derlemek icin gerekli.
  DOTNET_ROOT="$HOME/.dotnet" "$DOTNET" publish "$WORKER_PROJ" \
    -c Release -o "$APP_DIR" --nologo -v quiet
  c_grn "Kuruldu: $APP_DIR"
}

write_plist() {
  mkdir -p "$LOG_DIR"
  cat > "$PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>

  <key>ProgramArguments</key>
  <array>
    <string>$APP_DIR/GGHub.Worker</string>
  </array>

  <key>WorkingDirectory</key>
  <string>$BOT_HOME</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>DOTNET_ROOT</key>
    <string>$HOME/.dotnet</string>
    <key>GGHUB_BOT_HOME</key>
    <string>$BOT_HOME</string>
    <key>DOTNET_ENVIRONMENT</key>
    <string>Production</string>
  </dict>

  <!-- Bilgisayar acilir acilmaz baslasin -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Cokerse yeniden baslat; temiz cikista (kuyruk bitti) birak -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- Surekli cokme durumunda saniyede bir yeniden baslamayi engelle -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>$LOG_DIR/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>$LOG_DIR/stderr.log</string>

  <!-- Arka plan isi: kullanici uygulamalarina onculuk etmesin -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>5</integer>
</dict>
</plist>
PLIST_EOF
  c_grn "LaunchAgent yazildi: $PLIST"
}

seed_config() {
  if [ -f "$CONFIG" ]; then
    c_dim "Ayar dosyasi zaten var, dokunulmadi: $CONFIG"
    return
  fi

  local example="$REPO_ROOT/backend/GGHub.Worker/appsettings.example.json"
  local dev="$REPO_ROOT/backend/GGHub.WebAPI/appsettings.Development.json"

  mkdir -p "$BOT_HOME"
  cp "$example" "$CONFIG"
  chmod 600 "$CONFIG"

  c_ylw ""
  c_ylw "Ayar dosyasi olusturuldu: $CONFIG"
  if [ -f "$dev" ]; then
    c_ylw "Baglanti bilgilerini ve anahtarlari su dosyadan kopyalaman gerekiyor:"
    c_ylw "  $dev"
    c_ylw "Gerekli alanlar: ConnectionStrings.DefaultConnection, RawgApiSettings.ApiKey, Gemini.ApiKey"
  fi
  c_ylw "Anahtarlari elle tasi (chmod 600 ayarlandi), sonra: gghub-bot start"
  c_ylw ""
}

cmd_install() {
  mkdir -p "$BOT_HOME" "$LOG_DIR"
  seed_config
  build_and_publish
  write_plist

  if is_loaded; then
    launchctl unload "$PLIST" 2>/dev/null || true
  fi
  launchctl load "$PLIST"

  c_grn ""
  c_grn "Kurulum tamam. Bot her acilista otomatik baslayacak."
  c_grn "Durum:  gghub-bot status"
  c_grn "Log:    gghub-bot logs"
}

cmd_start() {
  [ -f "$PLIST" ] || die "Once 'gghub-bot install' calistir."
  is_loaded && { c_ylw "Zaten calisiyor."; return; }
  launchctl load "$PLIST"
  c_grn "Baslatildi."
}

cmd_stop() {
  [ -f "$PLIST" ] || die "LaunchAgent yok."
  is_loaded || { c_ylw "Zaten durmus."; return; }
  launchctl unload "$PLIST"
  c_grn "Durduruldu."
}

cmd_restart() {
  cmd_stop 2>/dev/null || true
  sleep 1
  cmd_start
}

cmd_update() {
  local was_running=0
  is_loaded && was_running=1

  [ "$was_running" -eq 1 ] && { launchctl unload "$PLIST"; c_dim "Durduruldu."; }
  build_and_publish
  write_plist
  [ "$was_running" -eq 1 ] && { launchctl load "$PLIST"; c_grn "Yeniden baslatildi."; } || c_ylw "Bot durmus durumda; baslatmak icin: gghub-bot start"
}

# Botu tamamen ortadan kaldirir: calisan surec, acilista baslatma ve kurulum dosyalari.
# Prod veritabanina yazilmis veriye DOKUNMAZ (aciklamalar, ceviriler, puanlar yerinde kalir);
# bot yalnizca veriyi uretiyor, sahibi degil.
cmd_uninstall() {
  echo
  c_ylw "Bot tamamen kaldirilacak:"
  echo "  - calisan surec durdurulacak"
  echo "  - acilista otomatik baslatma iptal edilecek ($PLIST)"
  echo "  - kurulum dizini silinecek ($APP_DIR)"
  echo
  echo "  KALACAKLAR: DB'deki veriler, ayar dosyan ve loglar"
  echo "              ($CONFIG)"
  echo
  printf "Devam edilsin mi? [e/H] "
  read -r answer
  case "$answer" in
    e|E|y|Y|evet|Evet) ;;
    *) c_ylw "Iptal edildi, hicbir sey yapilmadi."; return 0 ;;
  esac

  if is_loaded; then
    launchctl unload "$PLIST" 2>/dev/null || true
    c_grn "Durduruldu ve acilis kaydi kaldirildi."
  fi

  # Sureci launchctl kacirirsa diye ikinci emniyet
  pkill -f "$APP_DIR/GGHub.Worker" 2>/dev/null || true

  if [ -f "$UPDATER_PLIST" ]; then
    launchctl unload "$UPDATER_PLIST" 2>/dev/null || true
    rm -f "$UPDATER_PLIST" "$UPDATER_SCRIPT" "$UPDATE_STAMP"
    c_grn "Otomatik guncelleyici kaldirildi."
  fi

  [ -f "$PLIST" ] && { rm -f "$PLIST"; c_grn "Silindi: $PLIST"; }
  [ -d "$APP_DIR" ] && { rm -rf "$APP_DIR"; c_grn "Silindi: $APP_DIR"; }

  echo
  c_grn "Bot tamamen kaldirildi. Artik hicbir sey calismiyor."
  c_dim "Ayarlarin ve loglarin duruyor: $BOT_HOME"
  c_dim "Onlari da silmek icin:  rm -rf $BOT_HOME"
  c_dim "Geri kurmak icin:       ./scripts/gghub-bot install"
  echo
}

# ---------------------------------------------------------------------------------------------
# Otomatik guncelleme
#
# NEDEN: bot, repodaki kodun DERLENMIS bir kopyasini calistirir. main'e push edilen yeni backend
# kodu bu kopyaya kendiliginden ulasmiyordu; 29 Eyl 2026'da push'tan sonra bot eski surumde kaldi,
# yeni hype job'i hic calismadi ve gundem vitrini bozuk gorundu.
#
# NASIL: LaunchAgent 10 dakikada bir "autoupdate" calistirir.
#   1. origin/main cekilir. Kaynak YEREL CALISMA AGACI DEGIL origin/main'dir: yerelde yarim kalmis,
#      push edilmemis degisiklikler prod'a yazan bota asla girmemeli. Railway de origin/main'i calistirir.
#   2. origin/main'deki backend/ agacinin hash'i son kurulumla ayniysa hicbir sey yapilmaz
#      (yalnizca ui/ veya mobile-ui/ degisen push'lar botu yeniden baslatmaz).
#   3. Degistiyse backend/ KIOXIA'daki derleme alanina cikarilir ve orada derlenir.
#   4. Yeni derleme "--check-schema" ile sinanir. Railway yeni migration'i henuz uygulamadiysa
#      eski bot calismaya devam eder, yeni derleme 10 dakika sonra tekrar denenir.
#   5. Gecerse bot durdurulur, yeni derleme kurulur, bot yeniden baslatilir.
# ---------------------------------------------------------------------------------------------

log_update() {
  mkdir -p "$LOG_DIR"
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$UPDATE_LOG"
}

cmd_autoupdate() {
  # Iki guncelleme ust uste binmesin (derleme 10 dakikadan uzun surebilir).
  # Kilit degiskeni GLOBAL: EXIT trap'i fonksiyon dondukten sonra calisir ve set -u altinda
  # local bir degisken orada tanimsiz kalirdi.
  AUTOUPDATE_LOCK="$BOT_HOME/autoupdate.lock"
  if ! mkdir "$AUTOUPDATE_LOCK" 2>/dev/null; then
    # 2 saatten eski kilit onceki kosunun coktugunu gosterir; birak.
    if [ -n "$(find "$AUTOUPDATE_LOCK" -maxdepth 0 -mmin +120 2>/dev/null)" ]; then
      rm -rf "$AUTOUPDATE_LOCK"; mkdir "$AUTOUPDATE_LOCK" || return 0
    else
      return 0
    fi
  fi
  trap 'rm -rf "$AUTOUPDATE_LOCK"' EXIT

  [ -d "$REPO_ROOT/.git" ] || return 0            # KIOXIA takili degil
  [ -x "$DOTNET" ] || { log_update "dotnet yok: $DOTNET"; return 0; }

  if ! git -C "$REPO_ROOT" fetch -q origin main 2>>"$UPDATE_LOG"; then
    log_update "git fetch basarisiz (ag yok?), sonraki turda denenecek."
    return 0
  fi

  local commit tree built
  commit="$(git -C "$REPO_ROOT" rev-parse --short origin/main)"
  tree="$(git -C "$REPO_ROOT" rev-parse origin/main:backend)"
  built="$(awk '{print $1}' "$UPDATE_STAMP" 2>/dev/null || true)"
  [ "$tree" = "$built" ] && return 0

  log_update "backend degisti (origin/main $commit), derleniyor..."

  local src="$BUILD_ROOT/src" out="$BUILD_ROOT/app"
  rm -rf "$src" "$out"
  mkdir -p "$src"
  if ! git -C "$REPO_ROOT" archive origin/main backend | tar -x -C "$src"; then
    log_update "git archive basarisiz."
    return 0
  fi

  if ! DOTNET_ROOT="$HOME/.dotnet" "$DOTNET" publish "$src/backend/GGHub.Worker/GGHub.Worker.csproj" \
      -c Release -o "$out" --nologo -v quiet >>"$UPDATE_LOG" 2>&1; then
    log_update "DERLEME HATASI ($commit). Bot eski surumle calismaya devam ediyor."
    return 0
  fi

  # Sema kapisi: yeni derleme DB'nin gerisinde/ilerisinde mi?
  local schema
  if ! schema="$(DOTNET_ROOT="$HOME/.dotnet" GGHUB_BOT_HOME="$BOT_HOME" DOTNET_ENVIRONMENT=Production \
      "$out/GGHub.Worker" --check-schema 2>/dev/null | tail -1)"; then
    log_update "Bekleniyor: ${schema:-DB'ye ulasilamadi}. Railway deploy'u bitince tekrar denenecek."
    return 0
  fi

  local was_running=0
  is_loaded && was_running=1
  [ "$was_running" -eq 1 ] && launchctl unload "$PLIST" 2>/dev/null

  rm -rf "$APP_DIR.new"
  cp -R "$out" "$APP_DIR.new"
  rm -rf "$APP_DIR.old"
  [ -d "$APP_DIR" ] && mv "$APP_DIR" "$APP_DIR.old"
  mv "$APP_DIR.new" "$APP_DIR"
  rm -rf "$APP_DIR.old"

  [ "$was_running" -eq 1 ] && launchctl load "$PLIST"
  echo "$tree $commit" > "$UPDATE_STAMP"
  log_update "Kuruldu: origin/main $commit. Bot $([ "$was_running" -eq 1 ] && echo 'yeniden baslatildi' || echo 'durmus durumdaydi, baslatilmadi')."

  # Guncelleyicinin kendi kopyasini da tazele. mv yeni bir dosya yaratir; calismakta olan bu
  # surec eski dosyayi okumaya devam eder, yarim okunmus script sorunu olmaz.
  if git -C "$REPO_ROOT" show origin/main:scripts/gghub-bot > "$UPDATER_SCRIPT.tmp" 2>/dev/null; then
    chmod +x "$UPDATER_SCRIPT.tmp" && mv "$UPDATER_SCRIPT.tmp" "$UPDATER_SCRIPT"
  fi
}

cmd_autoupdate_install() {
  mkdir -p "$BOT_HOME" "$LOG_DIR"

  # LaunchAgent repodaki scripti DEGIL, ~/.gghub-bot'taki kopyasini calistirir: KIOXIA takili
  # degilken launchd'nin her 10 dakikada bir "dosya yok" hatasi yazmasi yerine script kendisi
  # sessizce cikar.
  cp "$SCRIPT_PATH/gghub-bot" "$UPDATER_SCRIPT"
  chmod +x "$UPDATER_SCRIPT"

  cat > "$UPDATER_PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$UPDATER_LABEL</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$UPDATER_SCRIPT</string>
    <string>autoupdate</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>GGHUB_REPO</key>
    <string>$REPO_ROOT</string>
    <key>GGHUB_BOT_HOME</key>
    <string>$BOT_HOME</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
  </dict>

  <!-- 10 dakikada bir + her acilista -->
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>$LOG_DIR/autoupdate.out.log</string>
  <key>StandardErrorPath</key>
  <string>$LOG_DIR/autoupdate.out.log</string>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
PLIST_EOF

  launchctl list 2>/dev/null | grep -q "$UPDATER_LABEL" && launchctl unload "$UPDATER_PLIST" 2>/dev/null
  launchctl load "$UPDATER_PLIST"

  c_grn "Otomatik guncelleyici kuruldu: 10 dakikada bir origin/main kontrol edilir."
  c_dim "Log: $UPDATE_LOG"
}

cmd_logs() {
  local f="$LOG_DIR/stdout.log"
  [ -f "$f" ] || die "Henuz log yok: $f"
  c_dim "Cikmak icin Ctrl-C  ($f)"
  tail -f "$f" "$LOG_DIR/stderr.log"
}

cmd_status() {
  echo
  if is_loaded; then
    local pid
    pid="$(launchctl list | grep "$LABEL" | awk '{print $1}')"
    if [ "$pid" = "-" ]; then
      c_ylw "Durum   : yuklu ama calismıyor (cikmis; son cikis kodu icin: gghub-bot logs)"
    else
      c_grn "Durum   : CALISIYOR (pid $pid)"
    fi
  else
    c_red "Durum   : durdurulmus (gghub-bot start)"
  fi

  echo "Kurulum : $APP_DIR"
  echo "Ayarlar : $CONFIG"
  echo "Loglar  : $LOG_DIR"
  if [ -f "$UPDATER_PLIST" ]; then
    echo "Guncelle: otomatik, 10 dk'da bir (kurulu surum: $(awk '{print $2}' "$UPDATE_STAMP" 2>/dev/null || echo '-'))"
    [ -f "$UPDATE_LOG" ] && echo "          son: $(tail -1 "$UPDATE_LOG")"
  else
    c_ylw "Guncelle: ELLE (otomatik icin: gghub-bot autoupdate-install)"
  fi
  echo

  # Ilerleme ve harcama ozetini worker'in kendisine sorduruyoruz (--status: okur, basar, cikar;
  # hicbir job tetiklemez). Boylece psql gibi bir bagimlilik yok ve ozet, botun kullandigi
  # baglanti dizesinin ta kendisini kullaniyor: gosterilen sey ile botun gordugu sey hep ayni.
  if [ ! -x "$APP_DIR/GGHub.Worker" ]; then
    c_dim "(kurulum yok; ozet icin once: gghub-bot install)"
    return
  fi

  DOTNET_ROOT="$HOME/.dotnet" GGHUB_BOT_HOME="$BOT_HOME" DOTNET_ENVIRONMENT=Production \
    "$APP_DIR/GGHub.Worker" --status 2>/dev/null || c_dim "(DB'ye ulasilamadi; 'gghub-bot logs' ile bak)"
}

case "${1:-}" in
  install)   cmd_install ;;
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  restart)   cmd_restart ;;
  update)    cmd_update ;;
  autoupdate)         cmd_autoupdate ;;
  autoupdate-install) cmd_autoupdate_install ;;
  status)    cmd_status ;;
  logs)      cmd_logs ;;
  uninstall) cmd_uninstall ;;
  *)
    cat <<'USAGE'
Kullanim: gghub-bot <komut>

  install     Derle, kur ve her acilista otomatik baslat (bir kez calistir)
  status      Calisiyor mu + bu ayki Gemini harcamasi + kalan kuyruk
  logs        Canli log akisi (Ctrl-C ile cik)
  stop        Botu durdur (acilista yine baslar)
  start       Durmus botu baslat
  restart     Durdur ve baslat
  update      Repodan yeniden derle, kur, yeniden baslat
  autoupdate-install
              Otomatik guncelleyiciyi kur: origin/main'de backend degisince bot
              kendini yeniden derler ve baslatir (bir kez calistir)
  uninstall   TAMAMEN kaldir: durdur + acilis kaydini sil + dosyalari sil

USAGE
    exit 1
    ;;
esac
